{
  "uid": "nr33-api",
  "title": "NR-33 — Observabilidade da API",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["nr33"],
  "panels": [
    {
      "id": 1, "title": "Disponibilidade da coleta da API", "type": "stat",
      "description": "up indica sucesso da coleta autenticada, sem consultar o banco. 0 = coleta indisponivel; ausencia de serie = alvo nao configurado.",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "nr33-prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"nr33-api\"}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 2, "title": "Requisicoes por segundo", "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "nr33-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(nr33_http_requests_total{job=\"nr33-api\"}[$__rate_interval]))", "legendFormat": "req/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 3, "title": "Erros HTTP por segundo (4xx e 5xx)", "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "nr33-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status_code) (rate(nr33_http_errors_total{job=\"nr33-api\"}[$__rate_interval]))", "legendFormat": "{{status_code}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 4, "title": "Latencia p50 e p95", "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "nr33-prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(nr33_http_request_duration_seconds_bucket{job=\"nr33-api\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(nr33_http_request_duration_seconds_bucket{job=\"nr33-api\"}[$__rate_interval])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 5, "title": "Memoria Node.js", "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "nr33-prometheus" },
      "targets": [
        { "refId": "A", "expr": "nr33_process_resident_memory_bytes{job=\"nr33-api\"}", "legendFormat": "RSS {{instance}}" },
        { "refId": "B", "expr": "nr33_process_heap_used_bytes{job=\"nr33-api\"}", "legendFormat": "Heap {{instance}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] }
    },
    {
      "id": 6, "title": "CPU Node.js (nucleos utilizados)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "nr33-prometheus" },
      "targets": [{ "refId": "A", "expr": "rate(nr33_process_cpu_seconds_total{job=\"nr33-api\"}[$__rate_interval])", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    },
    {
      "id": 7, "title": "Requisicoes simultaneas", "type": "timeseries",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "nr33-prometheus" },
      "targets": [{ "refId": "A", "expr": "nr33_http_requests_in_flight{job=\"nr33-api\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "min": 0, "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8, "title": "Percentual de erros HTTP", "type": "timeseries",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "nr33-prometheus" },
      "targets": [{ "refId": "A", "expr": "100 * ((sum(rate(nr33_http_errors_total{job=\"nr33-api\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(nr33_http_requests_total{job=\"nr33-api\"}[$__rate_interval])), 0.000001))", "legendFormat": "4xx + 5xx" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent" }, "overrides": [] }
    }
  ]
}
